<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient"
    tools:context=".MainActivity">

    <!-- Tab 1 Container (Mirroring Controls) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutMirroringContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:padding="20dp"
        android:visibility="visible"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomTabBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Premium App Header -->
        <TextView
            android:id="@+id/tvHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mirror Connect"
            android:textColor="#F8FAFC"
            android:textSize="26sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tvSubHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ultra Fast Wireless Screen Mirroring"
            android:textColor="#38BDF8"
            android:textSize="13sp"
            android:fontFamily="sans-serif"
            android:layout_marginTop="4dp"
            app:layout_constraintTop_toBottomOf="@id/tvHeader"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Control Panel Card Container -->
        <LinearLayout
            android:id="@+id/cardContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="18dp"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/tvSubHeader"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Manual IP Input Label -->
            <TextView
                android:id="@+id/tvIpLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RECEIVER IP ADDRESS"
                android:textColor="#94A3B8"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <!-- Styled IP Input -->
            <EditText
                android:id="@+id/etIpAddress"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="e.g. 192.168.1.8"
                android:inputType="number|text"
                android:text="192.168.1.100"
                android:textColor="#F8FAFC"
                android:textColorHint="#475569"
                android:background="@drawable/bg_input"
                android:paddingHorizontal="14dp"
                android:textSize="15sp"
                android:layout_marginTop="6dp" />

            <!-- Auto-Discovery Section Label -->
            <TextView
                android:id="@+id/tvDiscoveryLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AUTO-DISCOVERED RECEIVERS"
                android:textColor="#94A3B8"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:layout_marginTop="16dp" />

            <!-- Styled Auto-Discovery Spinner -->
            <Spinner
                android:id="@+id/spReceivers"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_input"
                android:layout_marginTop="6dp"
                android:paddingHorizontal="10dp" />

        </LinearLayout>

        <!-- Scan & Test Buttons -->
        <LinearLayout
            android:id="@+id/buttonContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/cardContainer"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <Button
                android:id="@+id/btnScan"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1.1"
                android:text="Scan Receivers"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:backgroundTint="#2563EB"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/btnTestConnection"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="0.9"
                android:text="Test Link"
                android:textColor="#F8FAFC"
                android:textSize="13sp"
                android:backgroundTint="#475569"
                android:layout_marginStart="6dp" />

        </LinearLayout>

        <!-- Toggle Mirroring Button -->
        <Button
            android:id="@+id/btnToggle"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Start Mirroring"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="#10B981"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/buttonContainer"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Terminal Title Bar -->
        <LinearLayout
            android:id="@+id/terminalTitleBar"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:background="#1E293B"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:layout_marginTop="20dp"
            app:layout_constraintTop_toBottomOf="@id/btnToggle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Red Dot -->
            <View
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@android:color/holo_red_light"
                android:backgroundTint="#EF4444"
                android:layout_marginEnd="6dp"/>

            <!-- Yellow Dot -->
            <View
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@android:color/holo_orange_light"
                android:backgroundTint="#F59E0B"
                android:layout_marginEnd="6dp"/>

            <!-- Green Dot -->
            <View
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@android:color/holo_green_light"
                android:backgroundTint="#10B981"
                android:layout_marginEnd="12dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="terminal - diagnostics"
                android:textColor="#64748B"
                android:textSize="10sp"
                android:fontFamily="monospace"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Styled Logs Terminal Window -->
        <ScrollView
            android:id="@+id/scrollViewLayout"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:background="@drawable/bg_logs"
            android:padding="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/terminalTitleBar">
            
            <TextView
                android:id="@+id/tvLogs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Console ready. Discovering server...\n"
                android:textColor="#38BDF8"
                android:textSize="11sp"
                android:lineSpacingExtra="3dp"
                android:fontFamily="monospace"/>
        </ScrollView>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Tab 2 Container (Web Dashboard WebView) -->
    <WebView
        android:id="@+id/webViewDashboard"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomTabBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Premium Bottom Tab Bar -->
    <LinearLayout
        android:id="@+id/bottomTabBar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:background="#0F172A"
        android:elevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Tab 1 Button (Mirror) -->
        <LinearLayout
            android:id="@+id/btnTabMirror"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackground">
            
            <TextView
                android:id="@+id/tvTabMirrorText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mirroring"
                android:textColor="#38BDF8"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#1E293B"
            android:layout_marginVertical="12dp" />

        <!-- Tab 2 Button (Dashboard) -->
        <LinearLayout
            android:id="@+id/btnTabDashboard"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackground">
            
            <TextView
                android:id="@+id/tvTabDashboardText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="YouTube Insights"
                android:textColor="#94A3B8"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
