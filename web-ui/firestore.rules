rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Pre-computed cache documents are publicly readable for guest view-only access
    match /cache/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    // All other raw collections require Google account authentication
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
